local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer
local localName = localPlayer.Name

-- Wait for the UI instead of erroring if it hasn't loaded yet
local button = localPlayer:WaitForChild("PlayerGui"):WaitForChild("Hotbar"):WaitForChild("Block")

local gfs = type(firesignal) == "function" and firesignal or type(getconnections) == "function" and getconnections
local useFiresignal = type(firesignal) == "function" and gfs == firesignal
local ballsFolder = workspace:WaitForChild("Balls")
local colorRed = Color3.fromRGB(255, 30, 30)
local colorGray = Color3.fromRGB(128, 128, 128)

if not gfs then
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Error",
        Text = "Your executor is not supported",
        Duration = 5,
    })
    return
end

local targetedBall = nil
local posBall = nil
local root = nil
local lastRadius = 15
local lastRadiusSq = 225
local fired = false
local spamToken = nil
local spamDelay = 0.05 -- raise this if the game ignores or punishes the spam

local sphere = Instance.new("SphereHandleAdornment")
sphere.Radius = 15
sphere.Color3 = colorGray
sphere.AlwaysOnTop = true
sphere.Transparency = 0.75
sphere.ZIndex = 1
sphere.Parent = workspace

-- Fire every common button signal, since the game may listen to any of them
local signals = { "MouseButton1Down", "MouseButton1Up", "MouseButton1Click", "Activated" }

local function fireBlock()
    for _, name in signals do
        local sig = button[name]
        if useFiresignal then
            pcall(gfs, sig)
        else
            local ok, conns = pcall(gfs, sig)
            if ok and conns then
                for _, c in conns do
                    pcall(c.Fire, c)
                end
            end
        end
    end
end

